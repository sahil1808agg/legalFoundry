# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only (API routes only), NEVER expose to client
# Used for admin operations that bypass RLS (only if needed; prefer anon key + RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Found in: platform.openai.com → API Keys
# SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_ or import in client components
OPENAI_API_KEY=sk-...

# ─── App ─────────────────────────────────────────────────────────────────────
# Base URL used for internal server-to-server fetch() calls (if any)
# In development: http://localhost:3000
# In production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
# Maximum number of chat messages to pass as context to the AI (default: 100)
# Increase for longer memory; decrease to reduce token usage and cost.
# SERVER-SIDE ONLY
MAX_CHAT_HISTORY=100

# ─── Storage ─────────────────────────────────────────────────────────────────
# Supabase Storage bucket name — must match the bucket created in supabase-schema.sql
# Default: "contracts" (private bucket, 10 MB limit, PDF only)
# No env var needed — bucket name is hardcoded as 'contracts' in the upload route.
# Listed here for reference only.
# SUPABASE_STORAGE_BUCKET=contracts

# ─── How to use ──────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in every value above
# 3. Run the SQL in docs/specs/supabase-schema.sql in the Supabase SQL Editor
# 4. Start the dev server: npm run dev
#
# NEVER commit .env.local to git. It is already listed in .gitignore.
